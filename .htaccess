DirectorySlash Off
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never keep the browser on /public (302 = not sticky in Firefox)
    RewriteRule ^public(?:/(.*))?$ /$1 [R=302,L]

    # Media URL /storage/* lives in public/storage (Laravel public disk)
    RewriteRule ^storage/(.*)$ public/storage/$1 [L]

    # Real files at docroot (build/pwa/... symlinks) are served as-is.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
